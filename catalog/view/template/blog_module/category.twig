{{ header }}
<style>
{{ custom_style }}
</style>
{% include 'extension/blog_module/catalog/view/template/partial/d_breadcrumb.twig' %}
    {% include 'extension/blog_module/catalog/view/template/partial/d_layout_open.twig' %}
        <div class="bm">
            <div class="bm-category-info clearfix">
                {% if edit %}<div class="btn-group btn-group-xs float-end" ><a class="btn btn-default " href="{{edit}}" target="_blank"><i class="fas fa-pencil-alt"></i> {{text_edit}}</a></div>{% endif %}
                <h1 class="h1 title">{{heading_title}}</h1>
                {% if (thumb and setting.category.image_display) %}
                <div class="image"><img src="{{thumb}}" alt="{{heading_title}}" title="{{heading_title}}" class="img-responsive" /></div>
                {% endif %}
                {% if description %}
                <div class="description">{{description}}</div>
                {% endif %}
            </div>

            {% if categories %}
            <div class="bm-categories">
                <div class="h3">{{text_categories}}</div>

                <div class="row auto-clear">
                    {% for category in categories %}
                    <div class="col-sm-{{category.col}} col-xs-4">
                        <a class="item-cateogry" href="{{category.href}}">
                            {% if setting.category.sub_category_image %}
                                <div class="image"><img src="{{category.thumb}}" alt="{{category.title}}" title="{{category.title}}" /></div>
                            {% endif %}
                            <div class="title">{{category.title}}</div>
                        </a>
                    </div>
                    {% endfor %}
                </div>

            </div>
            {% endif %}
            {% if posts %}
                {% include layout_template with posts %}
            {% endif %}

            {% if not posts and post_display_on_main == false %}
                <p class="bm-empty">{{text_empty}}</p>
                <div class="buttons">
                    <div class="float-end">
                            {% include 'extension/blog_module/catalog/view/template/partial/button.twig' with {button:{
                                link:continue, 
                                style:'primary',
                                text_button: button_continue
                        }} %}
                    </div>
                </div>
            {% endif %}
        </div>
    {% include 'extension/blog_module/catalog/view/template/partial/d_layout_close.twig' %}
{{footer}}
